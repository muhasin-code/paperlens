# --- Application ---
APP_ENV=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8000


# --- Paths ---
CHROMA_PERSIST_DIR=./data/chroma
BM25_INDEX_PATH=./data/bm25_index.pkl
PROCESSED_CHUNKS_PATH=./data/processed/chunks.parquet


# --- Ollama ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=phi4-mini


# --- LLM Provider (Phase 3) ---
LLM_PROVIDER=  # options: ollama, openai_compat
LLM_API_BASE_URL=
LLM_API_KEY=
LLM_MODEL=


# --- Embeddings & Retrieval ---
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-base
RETRIEVAL_TOP_K=20
RERANK_TOP_K=5
RRF_K=60
HYBRID_CANDIDATE_POOL=50
CHUNK_SIZE_TOKENS=600
CHUNK_OVERLAP_TOKENS=100
EMBEDDING_CHECKPOINT_PATH=./data/processed/embedding_checkpoint.jsonl


# --- arXiv Ingestion (Phase 01) ---
ARXIV_CATEGORY=cs.LG
# Alternatives: cs.CL (NLP), cs.AI (general AI)
ARXIV_MAX_RESULTS=500
ARXIV_DATE_FROM=2023-01-01
ARXIV_DATE_TO=2026-12-31
ARXIV_DELAY_SECONDS=3.0
METADATA_PATH=./data/raw/metadata.jsonl
PDF_DIR=./data/raw/pdfs
INGESTION_LOG=./data/raw/ingestion.log


# --- Fine-tuned extractor (Phase 03) ---
HF_HUB_MODEL_ID=
# Base: Qwen/Qwen2.5-3B-Instruct; adapter path on hub after fine-tuning
EXTRACTION_ADAPTER_REPO=
HF_TOKEN=
# Optional - only needed to push/pull private Hub assets


# --- Langfuse (Phase 04)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000


# --- Evaluation (Phase 04) ---
RAGAS_FAITHFULNESS_THRESHOLD=0.75
GOLD_DATASET_PATH=./eval/gold_dataset.jsonl


# --- Prompts ---
PROMPTS_DIR=./configs/prompts
PROMPT_VERSION=v1
